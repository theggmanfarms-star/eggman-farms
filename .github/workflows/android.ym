          # alarm sounds and icon come from your app files
          for s in chime marimba rise bell; do cp "alarm-$s.mp3" "android/app/src/main/res/raw/alarm_$s.mp3"; done
          cp icon-192.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png
          # the app opens your GitHub Pages address
          OWNER="$(echo "$GITHUB_REPOSITORY_OWNER" | tr '[:upper:]' '[:lower:]')"
          REPO="${GITHUB_REPOSITORY#*/}"
          sed -i "s#__APP_URL__#https://$OWNER.github.io/$REPO/#" android/app/src/main/java/com/theeggman/farms/MainActivity.java
          grep -n "APP_URL =" android/app/src/main/java/com/theeggman/farms/MainActivity.java
      - name: Build the APK
        working-directory: android
        env:
          VERSION_CODE: ${{ github.run_number }}
        run: gradle assembleRelease --no-daemon --stacktrace
      - name: Publish the APK
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          cp android/app/build/outputs/apk/release/app-release.apk EggManFarms.apk
          gh release view android >/dev/null 2>&1 || gh release create android --title "Egg Man Farms Android app" --notes "Install EggManFarms.apk on Android phones. Real alarms that ring with the screen off."
          gh release upload android EggManFarms.apk --clobber
          echo "Download: https://github.com/$GITHUB_REPOSITORY/releases/download/android/EggManFarms.apk"
      - uses: actions/upload-artifact@v4
        with:
          name: EggManFarms-apk
          path: EggManFarms.apk
